rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMemberOf(groupId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // get (single doc): any authenticated user can read by ID — needed for invite join flow
      // list (collection query): only members can query their groups
      allow get: if isAuth();
      allow list: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth();
      // allow existing members to update, OR allow joining (user adds themselves to memberIds)
      allow update: if isAuth() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMemberOf(groupId);
        allow create: if isAuth();
        allow delete: if isAuth() && request.auth.uid == memberId;
      }

      match /expenses/{expenseId} {
        allow read, create: if isMemberOf(groupId);
        allow update, delete: if isAuth() && resource.data.paidBy == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow read, create, update: if isMemberOf(groupId);
      }
    }

    match /invites/{inviteCode} {
      allow read, create: if isAuth();
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }
  }
}
