rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMemberOf(groupId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isAuth() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // get: any auth user can fetch a group by ID (needed for invite join flow)
      // list: only members can query their groups
      allow get: if isAuth();
      allow list: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // existing member updates OR self-join (user adds self to memberIds)
      allow update: if isAuth() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if isMemberOf(groupId);
        // user can add only themselves (invite/create flow)
        // existing members can remove others only via owner
        allow create: if isAuth() && request.auth.uid == memberId;
        allow delete: if isAuth() && (
          request.auth.uid == memberId || isGroupOwner(groupId)
        );
      }

      function membersCanAddExpenses(groupId) {
        let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
        return !('permissions' in g) || g.permissions.membersCanAddExpenses != false;
      }

      function membersCanSettle(groupId) {
        let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
        return !('permissions' in g) || g.permissions.membersCanSettle != false;
      }

      match /expenses/{expenseId} {
        allow read: if isMemberOf(groupId);
        // owner can always add; members only if permission allows
        allow create: if isMemberOf(groupId) && (
          isGroupOwner(groupId) || membersCanAddExpenses(groupId)
        );
        // owner can edit/delete any; payer or creator can edit/delete their own
        allow update, delete: if isAuth() && (
          isGroupOwner(groupId) ||
          resource.data.paidBy == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        );
      }

      match /settlements/{settlementId} {
        allow read: if isMemberOf(groupId);
        // owner can always settle; members only if permission allows
        allow create: if isMemberOf(groupId) && (
          isGroupOwner(groupId) || membersCanSettle(groupId)
        );
        // owner can delete any; creator can delete their own
        allow update, delete: if isAuth() && (
          isGroupOwner(groupId) ||
          resource.data.createdBy == request.auth.uid
        );
      }
    }

    match /invites/{inviteCode} {
      allow read, create: if isAuth();
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }
  }
}
